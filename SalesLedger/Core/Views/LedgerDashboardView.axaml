<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SalesLedger.Core.ViewModels"
             xmlns:models="using:SalesLedger.Core.Models"
             xmlns:views="using:SalesLedger.Core.Views"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="SalesLedger.Core.Views.LedgerDashboardView"
             x:DataType="vm:LedgerDashboardViewModel"
             Background="{DynamicResource BgAppDark}"
             FontFamily="{DynamicResource FontPrimary}">

    <UserControl.Styles>
        <Style Selector="DataGridRow StackPanel#ActionPanel">
            <Setter Property="Opacity" Value="0.0"/>
        </Style>
        <Style Selector="DataGridRow:pointerover StackPanel#ActionPanel">
            <Setter Property="Opacity" Value="1.0"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Main Scrollable Dashboard Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" Margin="24">
                
                <!-- TOP BAR: Controls & Action Triggers -->
                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
                        <Button Content="Import CSV Data..." 
                                Command="{Binding ShowImportDialogCommand}" 
                                Background="{DynamicResource AccentPurple}" Foreground="White" 
                                FontWeight="Bold" Padding="16,8" CornerRadius="6" Height="36" VerticalContentAlignment="Center">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource AccentPurpleHover}"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </StackPanel>

                    <!-- Add Button (preview / finalize live on the Payout Reports page) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                        <Button Content="+ Add Transaction" 
                                Command="{Binding ShowAddSaleDialogCommand}" 
                                Background="{DynamicResource AccentBlue}" Foreground="White" 
                                FontWeight="Bold" Padding="16,8" CornerRadius="6" Height="36" VerticalContentAlignment="Center">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource AccentBlueHover}"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- KPI METRICS GRID (4 CARDS) -->
                <Grid ColumnDefinitions="*, *, *, *">
                    <!-- Total Sales Card -->
                    <Border Grid.Column="0" Background="{DynamicResource BgCardDark}" BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                        <ToolTip.Tip>
                            <Border Background="{DynamicResource BgAppDark}" BorderBrush="{DynamicResource TextMuted}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="6" MinWidth="230">
                                    <TextBlock Grid.Row="0" Text="Gross sales (everything sold)" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GrossSales, StringFormat='\{0:C}'}" Foreground="{DynamicResource AccentBlue}" FontSize="11" FontWeight="Bold" Margin="12,0,0,0"/>
                                    <TextBlock Grid.Row="1" Text="Returns" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReturnsAmount, StringFormat='-\{0:C}'}" Foreground="{DynamicResource AccentRed}" FontSize="11" FontWeight="Bold" Margin="12,0,0,0"/>
                                    <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{DynamicResource BorderSlate}" BorderThickness="0,0,0,1"/>
                                    <TextBlock Grid.Row="3" Text="Net sales" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding NetSales, StringFormat='\{0:C}'}" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Bold" Margin="12,0,0,0"/>
                                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Foreground="{DynamicResource TextSecondary}" FontSize="10">
                                        <Run Text="{Binding GrossUnitsSold}"/>
                                        <Run Text="items sold ·"/>
                                        <Run Text="{Binding ReturnCount}"/>
                                        <Run Text="return transaction(s)"/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </ToolTip.Tip>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Total Sales (Gross)" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding GrossSales, StringFormat='\{0:C}'}" Foreground="{DynamicResource AccentBlue}" FontSize="26" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SalesSubText}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Units Sold Card -->
                    <Border Grid.Column="1" Background="{DynamicResource BgCardDark}" BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="10,0,10,0">
                        <ToolTip.Tip>
                            <TextBlock MaxWidth="260" TextWrapping="Wrap" FontSize="11"
                                       Text="Items sold minus items that came back (full returns). A partial refund, where the customer keeps the item, doesn't reduce this count."/>
                        </ToolTip.Tip>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Units Sold (Net)" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalUnitsSold}" Foreground="{DynamicResource AccentGreen}" FontSize="26" FontWeight="Bold"/>
                            <TextBlock Text="{Binding UnitsSubText}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Commission Card -->
                    <Border Grid.Column="2" Background="{DynamicResource BgCardDark}" BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="10,0,10,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Total Commission Earned" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalCommission, StringFormat='\{0:C}'}" Foreground="{DynamicResource AccentOrange}" FontSize="26" FontWeight="Bold"/>
                            <TextBlock Text="After return adjustments" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Average Sale Price Card -->
                    <Border Grid.Column="3" Background="{DynamicResource BgCardDark}" BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="10,0,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Average Sale Price (ASP)" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AverageSalePrice, StringFormat='\{0:C}'}" Foreground="{DynamicResource AccentPink}" FontSize="26" FontWeight="Bold"/>
                            <TextBlock Text="All sale types, items kept" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                       ToolTip.Tip="Average price of everything sold in this range (new, used, eBay and warranty), not counting items that were returned or fully refunded."/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- MIDDLE SECTION: Trends Chart (Full Width) -->
                <Grid ColumnDefinitions="*" Height="420">
                    <Border Background="{DynamicResource BgCardDark}" BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="10" Padding="20">
                        <Grid RowDefinitions="Auto, *">
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Sales Trends Graph" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding RangeDescription}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <!-- Custom range (KPIs, chart and category breakdown all follow it) -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsCustomTimeframe}">
                                        <CalendarDatePicker SelectedDate="{Binding ChartStartDate, Mode=TwoWay}" Width="130" Height="30" FontSize="12" ToolTip.Tip="Start date"/>
                                        <TextBlock Text="to" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                        <CalendarDatePicker SelectedDate="{Binding ChartEndDate, Mode=TwoWay}" Width="130" Height="30" FontSize="12" ToolTip.Tip="End date"/>
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding TimeframeOptions}" SelectedItem="{Binding SelectedTimeframe, Mode=TwoWay}" Width="170" Height="30" VerticalContentAlignment="Center" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding MetricOptions}" SelectedItem="{Binding SelectedMetric, Mode=TwoWay}" Width="120" Height="30" VerticalContentAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Graph Bars Layout Container -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding ChartItems}" VerticalAlignment="Bottom" Height="310">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" VerticalAlignment="Bottom"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChartItem">
                                        <Grid RowDefinitions="130, 1, 130, Auto" HorizontalAlignment="Center" Background="Transparent">
                                            <ToolTip.Tip>
                                                <Border Background="{DynamicResource BgAppDark}" BorderBrush="{DynamicResource TextMuted}" BorderThickness="1" CornerRadius="8" Padding="14">
                                                    <StackPanel Spacing="8" MinWidth="200">
                                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Bold"/>
                                                        
                                                        <Grid ColumnDefinitions="*, Auto">
                                                            <TextBlock Text="Total Sales:" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding TotalSalesText}" Foreground="{DynamicResource AccentBlue}" FontSize="11" FontWeight="Bold"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*, Auto">
                                                            <TextBlock Text="Units Sold:" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding TotalUnitsText}" Foreground="{DynamicResource AccentGreen}" FontSize="11" FontWeight="Bold"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*, Auto">
                                                            <TextBlock Text="Total Commission:" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding TotalCommissionText}" Foreground="{DynamicResource AccentOrange}" FontSize="11" FontWeight="Bold"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*, Auto">
                                                            <TextBlock Text="Highest Sale:" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding HighestSaleText}" Foreground="{DynamicResource AccentPink}" FontSize="11" FontWeight="Bold"/>
                                                        </Grid>

                                                        <Border BorderBrush="{DynamicResource BorderSlate}" BorderThickness="0,0,0,1" Margin="0,4"/>
                                                        <TextBlock Text="Type Breakdown" Foreground="{DynamicResource TextPrimary}" FontSize="10" FontWeight="Bold"/>
                                                        <Grid ColumnDefinitions="*, Auto" Margin="0,1">
                                                            <TextBlock Text="Standard:" Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding StandardBreakdownText}" Foreground="{DynamicResource TextPrimary}" FontSize="10" FontWeight="SemiBold"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*, Auto" Margin="0,1">
                                                            <TextBlock Text="eBay:" Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding EbayBreakdownText}" Foreground="{DynamicResource TextPrimary}" FontSize="10" FontWeight="SemiBold"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*, Auto" Margin="0,1">
                                                            <TextBlock Text="Warranty:" Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding WarrantyBreakdownText}" Foreground="{DynamicResource TextPrimary}" FontSize="10" FontWeight="SemiBold"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*, Auto" Margin="0,1" IsVisible="{Binding HasReturnOffsets}">
                                                            <TextBlock Text="Returns:" Foreground="{DynamicResource AccentRed}" FontSize="10"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding ReturnOffsetBreakdownText}" Foreground="{DynamicResource AccentRed}" FontSize="10" FontWeight="SemiBold"/>
                                                        </Grid>

                                                        <Border BorderBrush="{DynamicResource BorderSlate}" BorderThickness="0,0,0,1" Margin="0,4"/>
                                                        <TextBlock Text="Category Breakdown" Foreground="{DynamicResource TextPrimary}" FontSize="10" FontWeight="Bold"/>
                                                        <ItemsControl ItemsSource="{Binding CategoriesBreakdown}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:CategoryDisplay">
                                                                    <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding ValueText}" Foreground="{DynamicResource TextPrimary}" FontSize="10" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </ToolTip.Tip>
                                            
                                            <!-- Vertical Bar border (Positive) -->
                                            <Border Grid.Row="0" Width="18" 
                                                    Height="{Binding PositiveHeight}" 
                                                    Background="{DynamicResource AccentBlue}" 
                                                    CornerRadius="4,4,0,0" 
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Bottom">
                                                <Border.Styles>
                                                    <Style Selector="Border:pointerover">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBlueHover}"/>
                                                    </Style>
                                                </Border.Styles>
                                            </Border>

                                            <!-- Horizontal baseline separator (1px) -->
                                            <Border Grid.Row="1"
                                                    Height="1"
                                                    Background="{DynamicResource BorderSlate}"
                                                    HorizontalAlignment="Stretch"/>

                                            <!-- Vertical Bar border (Negative) -->
                                            <Border Grid.Row="2" Width="18" 
                                                    Height="{Binding NegativeHeight}" 
                                                    Background="{DynamicResource AccentRed}" 
                                                    CornerRadius="0,0,4,4" 
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    IsVisible="{Binding HasNegativeValue}">
                                                <Border.Styles>
                                                    <Style Selector="Border:pointerover">
                                                        <Setter Property="Background" Value="{DynamicResource AccentRedHover}"/>
                                                    </Style>
                                                </Border.Styles>
                                            </Border>

                                            <!-- Label below bar -->
                                            <TextBlock Grid.Row="3" Text="{Binding Label}" Foreground="{DynamicResource TextSecondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>

                <!-- CATEGORY SALES DISTRIBUTION SECTION -->
                <Border Background="{DynamicResource BgCardDark}" BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <Grid RowDefinitions="Auto, *">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Category Sales Distribution" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Proportional category breakdown for the selected timeframe." FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="View By:" Foreground="{DynamicResource TextPrimary}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding CategoryBreakdownMetricOptions}" 
                                          SelectedItem="{Binding CategoryBreakdownMetric, Mode=TwoWay}" 
                                          Width="140" Height="30" VerticalContentAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                        
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding CategoryBreakdownItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryBreakdownItem">
                                    <Grid RowDefinitions="Auto, Auto" Margin="0,2">
                                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding ValueText}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                                <TextBlock Text="{Binding Percentage, StringFormat='\{0:F1}%'}" Foreground="{Binding Color}" FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <ProgressBar Grid.Row="1" 
                                                     Value="{Binding Percentage}" 
                                                     Minimum="0" Maximum="100" 
                                                     Height="8" 
                                                     Foreground="{Binding Color}" 
                                                     Background="{DynamicResource BorderSlate}" 
                                                     CornerRadius="4"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- TRANSACTION LEDGER DATA GRID -->
                <Border Background="{DynamicResource BgCardDark}" BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="10" Padding="12">
                    <Grid RowDefinitions="Auto, Auto, Auto, *">
                        <!-- Header with title, Reset Filters button, and High Value toggle -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="12,8,12,12">
                            <TextBlock Text="Recent Sales Ledger" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Reset Filters" Command="{Binding ResetFiltersCommand}" Background="{DynamicResource BorderSlate}" Foreground="White" Padding="10,4" CornerRadius="4" FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource TextMuted}"/>
                                    </Style>
                                </Button.Styles>
                            </Button>
                            <CheckBox Grid.Column="2" IsChecked="{Binding HighValueSalesOnly, Mode=TwoWay}" VerticalAlignment="Center">
                                <TextBlock Text="High Value Only (+$1,500)" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                            </CheckBox>
                        </Grid>
                        
                        <!-- Search & Filter Panel -->
                        <StackPanel Grid.Row="1" Spacing="12" Margin="12,0,12,16">
                            <Grid ColumnDefinitions="2*, *, *, *">
                                <!-- Search input -->
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                                    <TextBlock Text="Search Sale" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Search SKU, Product, Invoice/Order Code..." Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Type Filter -->
                                <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,10,0">
                                    <TextBlock Text="Sale Type" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding SaleTypeFilterOptions}" SelectedItem="{Binding SelectedSaleTypeFilter, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="32" VerticalContentAlignment="Center" FontSize="12"/>
                                </StackPanel>

                                <!-- Category Filter -->
                                <StackPanel Grid.Column="2" Spacing="4" Margin="0,0,10,0">
                                    <TextBlock Text="Category" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding CategoryFilterOptions}" SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="32" VerticalContentAlignment="Center" FontSize="12"/>
                                </StackPanel>

                                <!-- Date Filter Type -->
                                <StackPanel Grid.Column="3" Spacing="4">
                                    <TextBlock Text="Filter by Date" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding DateFilterTypeOptions}" SelectedItem="{Binding SelectedDateFilterType, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="32" VerticalContentAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <!-- Custom Date Range Panel (Visible when Custom is selected) -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsCustomDateFilter}">
                                <Grid ColumnDefinitions="*, 12, *">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Start Date" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                        <CalendarDatePicker SelectedDate="{Binding CustomStartDate, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="32" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="End Date" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                        <CalendarDatePicker SelectedDate="{Binding CustomEndDate, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="32" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Ledger message banner (e.g. an action that isn't allowed) -->
                        <Border Grid.Row="2" IsVisible="{Binding HasLedgerMessage}" Background="{DynamicResource BgAppDark}" BorderBrush="{DynamicResource AccentRed}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="12,0,12,12">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{Binding LedgerMessage}" Foreground="{DynamicResource AccentRed}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissLedgerMessageCommand}" Background="{DynamicResource BorderSlate}" Foreground="White" Padding="10,4" FontSize="11" CornerRadius="4" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- DataGrid -->
                        <DataGrid Grid.Row="3"
                                  ItemsSource="{Binding RecentSalesView}" 
                                  SelectedItem="{Binding SelectedSale, Mode=TwoWay}"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  CanUserSortColumns="True"
                                  CanUserResizeColumns="True"
                                  CanUserReorderColumns="True"
                                  Height="320"
                                  RowHeight="38"
                                  BorderBrush="{DynamicResource BorderSlate}"
                                  BorderThickness="1"
                                  Background="{DynamicResource BgAppDark}">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:DataType="models:SaleRecord" Header="Date" Binding="{Binding TransactionDate, StringFormat='\{0:yyyy-MM-dd}'}" Width="Auto" MinWidth="110" CanUserSort="True" SortMemberPath="TransactionDate"/>
                                <DataGridTextColumn x:DataType="models:SaleRecord" Header="Invoice / Order Code" Binding="{Binding InvoiceNumber}" Width="Auto" MinWidth="150" CanUserSort="True" SortMemberPath="InvoiceNumber"/>
                                <DataGridTextColumn x:DataType="models:SaleRecord" Header="Product Name" Binding="{Binding ProductName}" Width="*" MinWidth="180" CanUserSort="True" SortMemberPath="ProductName"/>
                                <DataGridTextColumn x:DataType="models:SaleRecord" Header="Category" Binding="{Binding Category}" Width="Auto" MinWidth="120" CanUserSort="True" SortMemberPath="Category"/>
                                <DataGridTextColumn x:DataType="models:SaleRecord" Header="Price" Binding="{Binding SalePrice, StringFormat='\{0:C}'}" Width="Auto" MinWidth="110" CanUserSort="True" SortMemberPath="SalePrice"/>
                                <DataGridTextColumn x:DataType="models:SaleRecord" Header="Commission" Binding="{Binding CalculatedCommission, StringFormat='\{0:C}'}" Width="Auto" MinWidth="130" CanUserSort="True" SortMemberPath="CalculatedCommission"/>
                                <DataGridTextColumn x:DataType="models:SaleRecord" Header="Status" Binding="{Binding Status}" Width="Auto" MinWidth="160" CanUserSort="True" SortMemberPath="Status"/>
                                
                                <DataGridTemplateColumn x:DataType="models:SaleRecord" Width="110" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:SaleRecord">
                                            <StackPanel Name="ActionPanel" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- Open Receipt Button (any sale, including paid receipts, to view or add products) -->
                                                <Button Command="{Binding $parent[DataGrid].((vm:LedgerDashboardViewModel)DataContext).OpenReceiptCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Open Receipt (view, edit, or add products)"
                                                        IsVisible="{Binding CanOpenReceipt}"
                                                        Background="{DynamicResource BorderSlate}" Padding="6,2" CornerRadius="4" BorderThickness="0" Height="26" Width="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                                                    <TextBlock Text="✎" Foreground="White" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Button>
                                                <!-- Edit Return Button (pending return lines: change the refund amount) -->
                                                <Button Command="{Binding $parent[DataGrid].((vm:LedgerDashboardViewModel)DataContext).EditReturnLineCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Edit Return Amount"
                                                        IsVisible="{Binding CanEditReturnLine}"
                                                        Background="{DynamicResource BorderSlate}" Padding="6,2" CornerRadius="4" BorderThickness="0" Height="26" Width="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                                                    <TextBlock Text="✎" Foreground="White" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Button>
                                                <!-- Restore Return Button -->
                                                <Button Command="{Binding $parent[DataGrid].((vm:LedgerDashboardViewModel)DataContext).ShowRestoreReturnDialogCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Restore Return"
                                                        IsVisible="{Binding IsReturnedBeforePayout}"
                                                        Background="{DynamicResource BorderSlate}" Padding="6,2" CornerRadius="4" BorderThickness="0" Height="26" Width="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                                                    <TextBlock Text="↺" Foreground="White" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Button>

                                                <!-- Process Return Button -->
                                                <Button Command="{Binding $parent[DataGrid].((vm:LedgerDashboardViewModel)DataContext).ProcessReturnCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Process Return"
                                                        IsVisible="{Binding CanProcessReturn}"
                                                        Background="{DynamicResource AccentRedHover}" Padding="6,2" CornerRadius="4" BorderThickness="0" Height="26" Width="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                                                    <TextBlock Text="↶" Foreground="White" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Button>

                                                <!-- Delete Button -->
                                                <Button Command="{Binding $parent[DataGrid].((vm:LedgerDashboardViewModel)DataContext).DeleteSaleCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Delete Transaction"
                                                        IsVisible="{Binding !IsPaid}"
                                                        Background="{DynamicResource AccentRed}" Padding="6,2" CornerRadius="4" BorderThickness="0" Height="26" Width="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                                                    <TextBlock Text="✕" Foreground="White" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- DIALOG OVERLAY: Add / Edit Transaction -->
        <Grid Background="{DynamicResource BgOverlay}" IsVisible="{Binding IsSaleDialogVisible}">
            <Border Background="{DynamicResource BgCardDark}" BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="12" Padding="24" Width="600" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    
                    <!-- Shared Transaction Header Fields -->
                    <Grid ColumnDefinitions="*, 12, *, 12, *">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding InvoiceLabel}" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                            <TextBox x:Name="InvoiceNumberBox" Text="{Binding InvoiceNumber, Mode=TwoWay}" PlaceholderText="{Binding InvoicePlaceholder}" IsReadOnly="{Binding IsInvoiceLocked}" Height="36" VerticalContentAlignment="Center"
                                     ToolTip.Tip="Locked because part of this receipt has been paid or returned"
                                     ToolTip.ServiceEnabled="{Binding IsInvoiceLocked}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Transaction Date" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                            <CalendarDatePicker SelectedDate="{Binding TransactionDate, Mode=TwoWay}" Height="36" HorizontalAlignment="Stretch" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="4">
                            <TextBlock Text="Sale Category Type" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                            <ComboBox SelectedIndex="{Binding SelectedRecordTypeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="36">
                                <ComboBoxItem Content="Standard Sale"/>
                                <ComboBoxItem Content="Warranty Sale"/>
                                <ComboBoxItem Content="eBay Sale"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- What's already on this receipt -->
                    <Border IsVisible="{Binding HasReceiptNotice}" Background="{DynamicResource BgAppDark}" BorderBrush="{DynamicResource AccentBlue}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="{Binding ReceiptNotice}" Foreground="{DynamicResource TextPrimary}" FontSize="11" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Product Entry Form -->
                    <Border BorderBrush="{DynamicResource BorderSlate}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Product Details" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            
                            <Grid ColumnDefinitions="*, 12, *">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="SKU / Item code" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                                    <TextBox x:Name="SkuBox" Text="{Binding Sku, Mode=TwoWay}" PlaceholderText="e.g. SKU-880" Height="36" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Product Name" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                                    <!-- Suggests names already in the ledger; picking one fills in its last category -->
                                    <AutoCompleteBox x:Name="ProductNameBox" Text="{Binding ProductName, Mode=TwoWay}"
                                                     ItemsSource="{Binding ProductNameSuggestions}"
                                                     SelectedItem="{Binding SelectedProductSuggestion, Mode=TwoWay}"
                                                     FilterMode="Contains"
                                                     MinimumPrefixLength="2"
                                                     MaxDropDownHeight="220"
                                                     PlaceholderText="e.g. Sony Alpha 7 IV"
                                                     Height="36"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*, 12, *">
                                <Panel Grid.Column="0">
                                    <!-- Category (Standard / eBay) -->
                                    <StackPanel Spacing="4" IsVisible="{Binding ShowCategory}">
                                        <TextBlock Text="Category" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="36"/>
                                    </StackPanel>
                                    <!-- Warranty Brand (Warranty) -->
                                    <StackPanel Spacing="4" IsVisible="{Binding ShowWarranty}">
                                        <TextBlock Text="Warranty Brand" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                                        <ComboBox ItemsSource="{Binding WarrantyTypes}" SelectedItem="{Binding WarrantyTypeName, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="36"/>
                                    </StackPanel>
                                </Panel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Sale Price" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                                    <NumericUpDown x:Name="SalePriceBox" Value="{Binding SalePrice, Mode=TwoWay}" Minimum="0" FormatString="C2" Height="36"/>
                                </StackPanel>
                            </Grid>

                            <!-- Conditional Fields & Add Button Row -->
                            <Grid ColumnDefinitions="*, 12, *">
                                <!-- Standard / eBay Sale Conditional Fields -->
                                <Panel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Spacing="6" IsVisible="{Binding ShowUsedGear}">
                                        <CheckBox IsChecked="{Binding IsUsedGear, Mode=TwoWay}" Margin="0,4,0,0">
                                            <TextBlock Text="Is Used Equipment" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                                        </CheckBox>
                                    </StackPanel>
                                </Panel>
                                
                                <!-- Warranty Sale Conditional Fields -->
                                <Panel Grid.Column="0">
                                    <StackPanel Spacing="4" IsVisible="{Binding ShowWarranty}">
                                        <TextBlock Text="Manufacturer Wholesale Price" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                                        <NumericUpDown Value="{Binding ManufacturerPrice, Mode=TwoWay}" Minimum="0" FormatString="C2" Height="36"/>
                                    </StackPanel>
                                </Panel>

                                <!-- Add Item Button (also when an existing receipt is open, to add another product) -->
                                <Button x:Name="AddItemButton" Grid.Column="2" Content="{Binding AddItemButtonText}" Command="{Binding AddDialogItemCommand}"
                                        Background="{DynamicResource AccentPurple}" Foreground="White" Height="36"
                                        VerticalContentAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        CornerRadius="6" FontWeight="SemiBold">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource AccentPurpleHover}"/>
                                        </Style>
                                    </Button.Styles>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Receipt Items: editable pending items, plus read-only paid / returned items and return lines -->
                    <StackPanel Spacing="8" IsVisible="{Binding HasDialogSales}" Margin="0,4,0,0">
                        <TextBlock Text="Items on this Receipt" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        <Border BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource BgAppDark}">
                            <ScrollViewer MaxHeight="180">
                                <ItemsControl ItemsSource="{Binding DialogLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReceiptLineViewModel">
                                            <Border BorderBrush="{DynamicResource BorderSlate}" BorderThickness="0,0,0,1" Padding="8,6" Background="Transparent">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="90, *, 75, 70, 100, Auto">
                                                        <!-- SKU -->
                                                        <TextBlock Grid.Column="0" Text="{Binding Sale.Sku}" Foreground="{DynamicResource TextPrimary}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <!-- Product Name -->
                                                        <TextBlock Grid.Column="1" Text="{Binding Sale.ProductName}" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <!-- Price -->
                                                        <TextBlock Grid.Column="2" Text="{Binding Sale.SalePrice, StringFormat={}{0:C2}}" Foreground="{DynamicResource TextPrimary}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <!-- Commission -->
                                                        <TextBlock Grid.Column="3" Text="{Binding Sale.CalculatedCommission, StringFormat={}{0:C2}}" Foreground="{DynamicResource AccentYellow}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <!-- Status -->
                                                        <TextBlock Grid.Column="4" Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondary}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        <!-- Action Buttons Panel -->
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <!-- Edit Button (pending items only) -->
                                                            <Button Command="{Binding $parent[UserControl].((vm:LedgerDashboardViewModel)DataContext).EditDialogItemCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="Edit Item"
                                                                    IsVisible="{Binding IsEditable}"
                                                                    Background="{DynamicResource BorderSlate}" Padding="6,2" CornerRadius="4" BorderThickness="0" Height="24" Width="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                                                                <TextBlock Text="✎" Foreground="White" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                            </Button>
                                                            <!-- Return Button (pending and paid items; applied on save) -->
                                                            <Button Command="{Binding $parent[UserControl].((vm:LedgerDashboardViewModel)DataContext).ReturnDialogItemCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="Return Item"
                                                                    IsVisible="{Binding CanStageReturn}"
                                                                    Background="{DynamicResource AccentRedHover}" Padding="6,2" CornerRadius="4" BorderThickness="0" Height="24" Width="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                                                                <TextBlock Text="↶" Foreground="White" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                            </Button>
                                                            <!-- Delete Button (pending items only) -->
                                                            <Button Command="{Binding $parent[UserControl].((vm:LedgerDashboardViewModel)DataContext).RemoveDialogItemCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="Remove Item from Receipt"
                                                                    IsVisible="{Binding IsEditable}"
                                                                    Background="{DynamicResource AccentRed}" Padding="6,2" CornerRadius="4" BorderThickness="0" Height="24" Width="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                                                                <TextBlock Text="✕" Foreground="White" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                            </Button>
                                                            <!-- Read-only marker -->
                                                            <TextBlock Text="🔒" IsVisible="{Binding IsReadOnly}" ToolTip.Tip="Read-only: paid, returned, or a return line" FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- A line dated differently from the receipt (e.g. added later with today's date) -->
                                                    <TextBlock Text="{Binding DateNote}" IsVisible="{Binding HasDateNote}" Foreground="{DynamicResource AccentYellow}" FontSize="10"/>

                                                    <!-- Staged return, applied when the receipt is saved -->
                                                    <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding HasStagedReturn}">
                                                        <TextBlock Text="{Binding StagedReturnText}" Foreground="{DynamicResource AccentRed}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="Undo" Command="{Binding $parent[UserControl].((vm:LedgerDashboardViewModel)DataContext).UndoStagedReturnCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="{DynamicResource BorderSlate}" Foreground="White" Padding="8,1" FontSize="10" CornerRadius="4"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding DialogErrorMessage}" IsVisible="{Binding HasDialogError}" Foreground="{DynamicResource AccentRed}" FontSize="12" TextWrapping="Wrap"/>

                    <!-- Dialog Actions Buttons -->
                    <Grid ColumnDefinitions="*, 12, *" Margin="0,12,0,0">
                        <Button Grid.Column="0" Content="Cancel" Command="{Binding CloseSaleDialogCommand}" Background="{DynamicResource BorderSlate}" Foreground="White" Height="36" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="6">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource TextMuted}"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                        <Button x:Name="SaveEntryButton" Grid.Column="2" Content="Save Entry" Command="{Binding SaveSaleCommand}" Background="{DynamicResource AccentBlue}" Foreground="White" Height="36" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="6" FontWeight="SemiBold">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource AccentBlueHover}"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DIALOG OVERLAY: CSV Import Wizard (mapping → review → import) -->
        <views:CsvImportDialogView DataContext="{Binding Import}"/>

        <!-- DIALOG OVERLAY: Restore Return Confirmation -->
        <Grid Background="{DynamicResource BgOverlay}" IsVisible="{Binding IsRestoreReturnDialogVisible}">
            <Border Background="{DynamicResource BgCardDark}" BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="12" Padding="24" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="Restore Returned Product" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Do you want to restore this transaction? This will mark the product as no longer returned, restore its status to Pending, and recalculate its commission." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    
                    <Grid ColumnDefinitions="*, 12, *" Margin="0,8,0,0">
                        <Button Grid.Column="0" Content="Cancel" Command="{Binding CloseRestoreReturnDialogCommand}" Background="{DynamicResource BorderSlate}" Foreground="White" Height="36" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="6">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource TextMuted}"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                        <Button Grid.Column="2" Content="Restore" Command="{Binding ExecuteRestoreReturnCommand}" Background="{DynamicResource AccentBlue}" Foreground="White" Height="36" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="6" FontWeight="SemiBold">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource AccentBlueHover}"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DIALOG OVERLAY: Confirmation (used SKU already sold, date for products added to an existing receipt) -->
        <Grid Background="{DynamicResource BgOverlay}" IsVisible="{Binding IsConfirmVisible}">
            <Border Background="{DynamicResource BgCardDark}" BorderBrush="{DynamicResource AccentYellow}" BorderThickness="1.5" CornerRadius="12" Padding="24" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding ConfirmTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentYellow}"/>
                    <TextBlock Text="{Binding ConfirmMessage}" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" LineHeight="20"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="{Binding ConfirmCancelText}" Command="{Binding ConfirmCancelCommand}" Background="{DynamicResource BorderSlate}" Foreground="White" Height="36" Padding="16,0" VerticalContentAlignment="Center" CornerRadius="6"/>
                        <Button Content="{Binding ConfirmSecondaryText}" Command="{Binding ConfirmSecondaryCommand}" IsVisible="{Binding HasConfirmSecondary}" Background="{DynamicResource AccentBlue}" Foreground="White" Height="36" Padding="16,0" VerticalContentAlignment="Center" CornerRadius="6" FontWeight="SemiBold"/>
                        <Button Content="{Binding ConfirmPrimaryText}" Command="{Binding ConfirmPrimaryCommand}" Background="{DynamicResource AccentBlue}" Foreground="White" Height="36" Padding="16,0" VerticalContentAlignment="Center" CornerRadius="6" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DIALOG OVERLAY: Return (full / partial / edit). Last so it sits above the receipt dialog. -->
        <views:ReturnDialogView DataContext="{Binding ReturnDialog}"/>
    </Grid>
</UserControl>
